# Configuración del backend local DEMO. Copiar a .env en la raíz si se necesita.
# Nunca introducir PAN, CVV, datos bancarios ni credenciales de proveedores reales.
PORT=8787
MOCK_SESSION_TTL_SECONDS=60

# Vacío: las peticiones de navegador con Origin se rechazan.
# Opcional: un único origen HTTP local exacto, por ejemplo http://localhost:3000.
MOCK_ALLOWED_ORIGIN=

# Opcional: elegir un secreto local propio si se desea exigir Bearer en la API.
# No se incluye ninguna clave ni credencial de ejemplo.
MOCK_API_TOKEN=
